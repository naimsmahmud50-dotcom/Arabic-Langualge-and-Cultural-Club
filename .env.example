# ==============================================================================
# Arabic Language & Cultural Club — Environment Configuration Template
# 
# SECURITY INSTRUCTION:
# 1. Copy this file to `.env.local` for local development or `.env.production` for production.
# 2. DO NOT commit actual passwords, private API keys, or JWT secrets to Git.
# 3. In production, always generate high-entropy random strings (min 32 bytes) for secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Canonical production URL (used for SEO canonical URLs, OpenGraph images, and redirect validation)
NEXT_PUBLIC_APP_URL=https://arabicclub.edu

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development & Standalone VPS (Default SQLite engine):
DATABASE_URL=./arabic_club.db

# Cloud Staging / Production (Supabase PostgreSQL / External DB):
# If connecting Drizzle ORM to a managed PostgreSQL cluster:
# DATABASE_URL=postgres://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# DIRECT_URL=postgres://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-random-32-byte-base64-secret-key-for-hmac
SESSION_SECRET=generate-random-32-byte-base64-secret-key-for-sessions
SESSION_COOKIE_NAME=alc_session_token
SESSION_MAX_AGE_SECONDS=604800 # 7 days (60 * 60 * 24 * 7)

# Initial Super Admin Seed (Used only by `pnpm db:seed` during initial deployment)
# Change immediately after first login via /admin/profile
INITIAL_ADMIN_EMAIL=arabicclubkngc2025@gmail.com
INITIAL_ADMIN_PASSWORD=SetAStrongRandomPassword123!

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION (High-Resolution Media & PDF Downloads)
# ------------------------------------------------------------------------------
# Local storage mode saves uploaded files to public/uploads/
# For cloud storage, configure Supabase Storage or S3-compatible bucket:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-side-only
STORAGE_BUCKET_MEDIA=arabic-club-media
STORAGE_BUCKET_DOCUMENTS=arabic-club-documents

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL CONFIGURATION (Inquiry & Registration Notifications)
# ------------------------------------------------------------------------------
# If unconfigured, the application runs safely with local-storage fallback
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_secret_resend_api_key
EMAIL_FROM="Arabic Language & Cultural Club, Kabi Nazrul Govt. College <arabicclubkngc2025@gmail.com>"

# ------------------------------------------------------------------------------
# 6. SITE BRANDING & LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
ENABLE_BANGLA_SUPPORT=false
