# ==============================================================================
# Arabic Language & Cultural Club — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (Default SQLite - Zero External Dependency):
DATABASE_URL=./arabic_club.db

# Production / Staging (PostgreSQL / Supabase):
# DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# DIRECT_URL=postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random secret for signing HMAC tokens and sessions
AUTH_SECRET=change-this-to-a-secure-random-secret-key-min-32-characters
SESSION_SECRET=change-this-to-a-secure-random-secret-key-min-32-characters
SESSION_COOKIE_NAME=arabic_club_session
SESSION_MAX_AGE_SECONDS=604800 # 7 days

# ------------------------------------------------------------------------------
# 4. SUPABASE / OBJECT STORAGE CONFIGURATION (For High-Res Photos & PDFs)
# ------------------------------------------------------------------------------
# Required for media uploads in staging and production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-server-side-only
STORAGE_BUCKET_MEDIA=arabic-club-media
STORAGE_BUCKET_DOCUMENTS=arabic-club-documents

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL CONFIGURATION (Optional for application notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-smtp-api-key
EMAIL_FROM="Arabic Language & Cultural Club <no-reply@arabicclub.org>"

# ------------------------------------------------------------------------------
# 6. SITE BRANDING & LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
ENABLE_BANGLA_SUPPORT=false
